# Configuración del servidor (VPS). Copiar a .env y completar:
#   cp .env.example .env

# Dominio público con https (el registro DNS tipo A debe apuntar a la IP del VPS)
NEXTAUTH_URL=https://entrenamiento.tudominio.cl
# Solo si se usa Caddy en vez de nginx (docker compose --profile caddy up -d)
APP_DOMAIN=entrenamiento.tudominio.cl

# Secreto de sesiones. Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=cambiar

# Base de datos (contenedor "db"). Usar una clave solo con letras y números:
#   openssl rand -hex 24
POSTGRES_USER=entrenamiento
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=entrenamiento

# Puerto local de la app (solo 127.0.0.1). Rango reservado 4060 a 4069; cambiarlo si otra app del VPS ya usa el 4060,
# y usar el mismo en /etc/nginx/sites-available/ejercicio-terapia
APP_PORT=4060

# Tamaño máximo por video subido, en MB
MAX_UPLOAD_MB=300

# true solo para una instalación de prueba: crea cuentas y datos de demostración
SEED_DEMO=false
