# /etc/nginx/sites-available/ejercicio-terapia
# Reemplazar entrenamiento.tudominio.cl por el dominio real (el mismo de NEXTAUTH_URL)
# y 3000 por APP_PORT si se cambió en .env.
# HTTPS: después de activar el sitio, correr certbot --nginx -d entrenamiento.tudominio.cl

server {
    listen 80;
    listen [::]:80;
    server_name entrenamiento.tudominio.cl;

    # Videos de ejercicios subidos desde la biblioteca (MAX_UPLOAD_MB es 300 por defecto).
    client_max_body_size 350M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Next.js envía las páginas en streaming; sin esto nginx las retiene hasta el final.
        proxy_buffering off;
        # Las subidas de video pasan directo a la app, sin guardarse antes en disco de nginx.
        proxy_request_buffering off;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
